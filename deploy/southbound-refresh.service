[Unit]
Description=Refresh official Southbound jobs and JD cache
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=southbound
Group=southbound
WorkingDirectory=/srv/southbound/app
Environment=SOUTHBOUND_DATA_ROOT=/var/lib/southbound
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 /srv/southbound/app/deploy/refresh.py
TimeoutStartSec=3600
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/southbound
MemoryMax=1G
TasksMax=128
